# Here we set a bunch of parameters for your image build

# output image name: your image is published as ghcr.io/<your-github-username>/claude-os
IMAGE_NAME=claude-os

# Your GitHub username. Only used for image labels, so the build works either way.
REPO_ORGANIZATION="doomsayer91"

IMAGE_DESC="Claude OS: Bazzite KDE with custom branding and the cos command"
IMAGE_KEYWORDS="bootc,oci,linux,bazzite,kde"

IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
